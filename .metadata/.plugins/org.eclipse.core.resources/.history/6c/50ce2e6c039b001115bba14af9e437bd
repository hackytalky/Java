package com.Loop;

public class Exercise7 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int sub = 0;
		for(int i = 1;i<=8;i++) {
			for(int k = 8;k>=1;k--) {
				System.out.print(" ");
			}
			for(int j = 1;j<=8;j++) {
				sub = j*3;
				System.out.print(sub + "  ");
			}
			for(int x = 1;x<=i;++x) {
				System.out.print(" ");
			}
			System.out.println();
		}
		
		
	}	

}
