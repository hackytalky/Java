package com.Loop;

import java.util.*;
public class Exercise6 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner input = new Scanner(System.in);
		
		int num = 0,reduce = 0;
		System.out.println("Enter a number: ");
		num = input.nextInt();
		
		for(int i = num; i>=1; i--) {
			for(int k = i;k>=1;k--) {
				System.out.print(k + " ");
			}
			for(int j = 2;j<=num;j--) {
				System.out.print(j + " ");
			}
			System.out.println();
		}	
	}

}
