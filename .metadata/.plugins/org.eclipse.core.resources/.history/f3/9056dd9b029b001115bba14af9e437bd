package com.Loop;

public class Exercise7 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		for(int i = 8;i>=1;i--) {
			for(int k = 8;k>=1;k--) {
				System.out.print(" ");
			}
			for(int j = 1;j<=8;j++) {
				j*=3;
				System.out.print(j);
			}
			System.out.println();
		}
		
		
	}	

}
