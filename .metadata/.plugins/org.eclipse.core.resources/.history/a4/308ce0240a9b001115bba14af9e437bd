package com.Loop;

public class Exercise7 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int i,j,n = 8;
	
		for(i = 1;i<=n;i++) {
			for(j = 1;j<=2 * (n-i);j++) {
				System.out.print("* ");
			}
			for(j = i;j >=1;j--) {
				System.out.print((int)Math.pow(3, j) + " ");
			}
			System.out.println();
		}
		
		
	}	

}
