package inheritance.com;
import java.util.*;

abstract class Calculator{
	private int num2;
	private int num1;
	
	public void setNum1(int getnum1) {
		num1 = getnum1;
	}
	public int getNum1() {
		return num1;
	}
	
	public void setNum2(int getnum2) {
		num2 = getnum2;
	}
	public int getNum2() {
		return num2;
	}
	
	public void greetings() {
		System.out.println("Thanks you for the service!!");
	}
	public abstract void results(int x, int y);
}
class Addition extends Calculator{
	@Override
	public void results(int x, int y) {
		setNum1(x);
		setNum2(y);
		int results = getNum1() + getNum2();
		System.out.println(getNum1() + " + " + getNum2() + " = " + results);
		super.greetings();
	}
	
	
}
class Multiplication extends Calculator{
	@Override
	public void results(int x, int y) {
		setNum1(x);
		setNum2(y);
		int results = getNum1() * getNum2();
		System.out.println(getNum1() + " * " + getNum2() + " = " + results);
		super.greetings();
		}
		
}

class Division extends Calculator{
	@Override
	public void results(int x, int y) {
		setNum1(x);
		setNum2(y);
		int results = getNum1() / getNum2();
		System.out.println(getNum1() + " / " + getNum2() + " = " + results);
		super.greetings();
		}
		
}

public class Example {
	
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner input = new Scanner(System.in);
		Multiplication mul = new Multiplication();
		Division div = new Division();
		Addition add = new Addition();
		int a = 0;
		int b = 0;
		char choice;
		while(true) {
			
			try{System.out.println("Enter values: ");
			a = Integer.parseInt(input.nextLine());
			b = Integer.parseInt(input.nextLine());
			}
			catch (NumberFormatException e) {
				System.out.println("Values should be integers!");
				continue;
			}
			
			String line = input.nextLine();
			if (line.isEmpty()) {
			    System.out.println("Please enter +, * or /.");
			    continue;
			}
			choice = line.charAt(0);
			
			switch(choice) {
			case '+':
				add.results(a, b);
				break;
			case '*':
				mul.results(a, b);
				break;
			case '/':
				try {
				div.results(a, b);
				}catch(ArithmeticException e) {
					System.out.println("Cannot divide by zero!");
				}
				break;
			default:
				System.out.println("None of the choices.");
				System.exit(0);
				break;
				
			}
		}
		
		
		
// this is simple example of inheritance 
		
		
		
	}

}
